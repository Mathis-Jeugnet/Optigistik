rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function getUserRole() {
      return request.auth != null ? request.auth.token.role : null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Vérifie que la paire de rôles est autorisée à communiquer directement.
    // Règle : Chauffeur ne peut parler qu'à Admin/Gestionnaire.
    //         Lecteur ne peut pas parler à un Chauffeur.
    function canRolesPairChat(r1, r2) {
      return !(
        (r1 == 'Chauffeur' && (r2 == 'Chauffeur' || r2 == 'Lecteur')) ||
        (r1 == 'Lecteur'   && r2 == 'Chauffeur')
      );
    }

    // ---------------------------------------------------------
    // UTILISATEURS (users)
    // ---------------------------------------------------------
    match /users/{userId} {
      // Tout utilisateur connecté peut lire les profils (nécessaire pour la messagerie).
      allow read: if isAuthenticated();

      allow create, delete: if isAuthenticated() && getUserRole() == 'Admin';
      allow update: if isAuthenticated() && (request.auth.uid == userId || getUserRole() == 'Admin');
    }

    // ---------------------------------------------------------
    // TOURNEES (tournees)
    // ---------------------------------------------------------
    match /tournees/{tourneeId} {
      allow read: if isAuthenticated() && (
        getUserRole() in ['Admin', 'Gestionnaire', 'Lecteur'] ||
        (getUserRole() == 'Chauffeur' && resource.data.driverId == request.auth.uid)
      );
      allow write: if isAuthenticated() && getUserRole() in ['Admin', 'Gestionnaire'];
    }

    // ---------------------------------------------------------
    // FLOTTE / CAMIONS (camions)
    // ---------------------------------------------------------
    match /camions/{camionId} {
      allow read: if isAuthenticated() && getUserRole() in ['Admin', 'Gestionnaire', 'Lecteur'];
      allow write: if isAuthenticated() && getUserRole() in ['Admin', 'Gestionnaire'];
    }

    // ---------------------------------------------------------
    // TYPOLOGIES / CONFIGURATION (typologies)
    // ---------------------------------------------------------
    match /typologies/{docId} {
      allow read: if isAuthenticated() && getUserRole() in ['Admin', 'Gestionnaire', 'Lecteur'];
      allow write: if isAuthenticated() && getUserRole() == 'Admin';
    }

    // ---------------------------------------------------------
    // CLIENTS (clients)
    // ---------------------------------------------------------
    match /clients/{clientId} {
      // Lecture & écriture : réservées à l'Admin et au Gestionnaire (Lecteur exclu)
      allow read, write: if isAuthenticated() && getUserRole() in ['Admin', 'Gestionnaire'];
    }

    // ---------------------------------------------------------
    // CONDUCTEURS (drivers)
    // ---------------------------------------------------------
    match /drivers/{driverId} {
      allow read: if isAuthenticated() && (
        getUserRole() in ['Admin', 'Gestionnaire', 'Lecteur'] ||
        (getUserRole() == 'Chauffeur' && request.auth.uid == driverId)
      );
      allow write: if isAuthenticated() && getUserRole() == 'Admin';
    }

    // ---------------------------------------------------------
    // MATRICES DE DISTANCE (distance_matrices)
    // ---------------------------------------------------------
    match /distance_matrices/{sessionId} {
      allow read: if isAuthenticated() && getUserRole() in ['Admin', 'Gestionnaire', 'Lecteur'];
      allow write: if isAuthenticated() && getUserRole() in ['Admin', 'Gestionnaire'];
    }

    // ---------------------------------------------------------
    // MESSAGERIE (conversations + messages)
    // ---------------------------------------------------------
    match /conversations/{conversationId} {
      // Lecture : uniquement les participants
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      // Création :
      // - Pour une conversation directe : la paire de rôles doit être autorisée
      // - Pour un groupe : seul Admin/Gestionnaire peut créer
      // Dans les deux cas, le créateur doit être dans la liste des participants
      // et son rôle stocké dans participantRoles doit correspondre à son token.
      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.participantRoles[request.auth.uid] == getUserRole()
        && (
          (
            request.resource.data.type == 'direct'
            && request.resource.data.participantIds.size() == 2
            && canRolesPairChat(
                request.resource.data.participantRoles[request.resource.data.participantIds[0]],
                request.resource.data.participantRoles[request.resource.data.participantIds[1]]
               )
          )
          ||
          (
            request.resource.data.type == 'group'
            && getUserRole() in ['Admin', 'Gestionnaire']
          )
        );

      // Mise à jour : seuls les participants peuvent mettre à jour (lastMessage, unreadCounts…)
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      // Suppression : réservée à Admin
      allow delete: if isAuthenticated() && getUserRole() == 'Admin';

      // Sous-collection messages
      match /messages/{messageId} {
        // Lecture/écriture : uniquement si l'utilisateur est participant de la conversation parente
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        allow create: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
          && request.resource.data.senderId == request.auth.uid;

        // Mise à jour uniquement pour marquer comme lu (readBy)
        allow update: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        allow delete: if false;
      }
    }

  }
}
